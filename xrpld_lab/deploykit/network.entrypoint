#!/bin/bash
# ./entrypoint.sh ledgerfile quorum
# ./entrypoint.sh /genesis.json 5

# Check if $1 is passed. "--load" is the db-seed sentinel: boot from the node's
# own database directory (restored from a state snapshot) instead of a genesis file.
if [[ "$1" == "--load" ]]; then
    ledgerfile="--load"
elif [[ -n "$1" ]]; then
    ledgerfile="--ledgerfile $1"
else
    ledgerfile=""
fi

# Check if $2 is passed
if [[ -n "$2" ]]; then
    quorum="--quorum=$2"
else
    quorum=""
fi

# Check if $3 is passed
if [[ -n "$3" ]]; then
    standalone="$3"
else
    standalone=""
fi

# Binary mode copies xrpld to /opt/xrpld/bin; release images ship it on PATH.
xrpld_bin=/opt/xrpld/bin/xrpld
[[ -x "$xrpld_bin" ]] || xrpld_bin=$(command -v xrpld)

# Start xrpld with or without ledgerfile and quorum
exec "$xrpld_bin" $ledgerfile $quorum $standalone --conf /opt/ripple/config/xrpld.cfg